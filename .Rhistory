# fwrite(bpe_invalid,file.path(outdir,"qc_invalid_bpe_age7_11.csv"));
# fwrite(bewe_age,file.path(outdir,"bewe_by_age.csv"));
fwrite(care_results,file.path(outdir,"adjusted_care_models.csv"))
fwrite(beh_adjusted,file.path(outdir,"behaviour_age_sex_adjusted_PR.csv"))
fwrite(cohort,file.path(outdir,"analysis_dataset.csv"),na="")
message("Done. Plots: ",normalizePath(plot_dir,mustWork=FALSE)," | Outputs: ",normalizePath(outdir,mustWork=FALSE))
