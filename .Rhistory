~var,~exposure,~exposed,~reference,
"brush_bin","Brushing frequency","<2/day",">=2/day",
"drink_bin","Drink type","Sugar-sweetened/acidic","Water",
"snack_bin","Snack type","Sweet/sugar rich","Other specified snacks",
"fluoride_bin","Fluoride toothpaste","No","Yes")
fit_beh <- function(var,exposure,exposed,reference,outcome){
z <- cohort |> filter(.data[[var]]%in%c(reference,exposed)) |>
transmute(y=as.numeric(.data[[outcome]]),
x=factor(.data[[var]],levels=c(reference,exposed)),age,gender) |> drop_na()
nx <- table(z$x); nr <- unname(nx[1]); ne <- unname(nx[2])
bad <- function(s) tibble(exposure,exposed,reference,outcome,n=nrow(z),n_reference=nr,n_exposed=ne,PR=NA_real_,low=NA_real_,high=NA_real_,p=NA_real_,status=s)
if(n_distinct(z$y)<2 || nr<2 || ne<2) return(bad("Too sparse"))
m <- tryCatch(glm(y~x+age+gender,data=z,family=poisson("log")),error=\(e)NULL)
if(is.null(m)) return(bad("Model failed"))
r <- tryCatch(robust_effect(m,grep("^x",names(coef(m)),value=TRUE)[1],"PR",exposure,nrow(z),"Modified Poisson + HC3"),error=\(e)NULL)
if(is.null(r)||!nrow(r)) return(bad("Not estimable"))
r |> transmute(exposure,exposed,reference,outcome,n,n_reference=nr,n_exposed=ne,
PR=estimate,low,high,p,status=if(min(nr,ne)<10)"Sparse—interpret cautiously" else "Estimated")
}
beh_adjusted <- pmap_dfr(beh_spec,\(var,exposure,exposed,reference)
bind_rows(fit_beh(var,exposure,exposed,reference,"any_untreated"),
fit_beh(var,exposure,exposed,reference,"any_caries"))) |>
group_by(outcome) |> mutate(fdr=p.adjust(p,"BH")) |> ungroup()
#-------------------------------------------------------------------------------
# 4. figures
# 1. Care-arrangement forest plot
care_plot <- care_results |> filter(!is.na(estimate),measure%in%c("PR","IRR")) |>
mutate(txt=sprintf("p = %.3f",p),label=str_wrap(label,32))
p_care <- ggplot(care_plot,aes(estimate,fct_rev(label)))+
geom_vline(xintercept=1,linetype=2,color="grey60")+
geom_errorbar(aes(xmin=low,xmax=high),orientation="y",width=.12,color=pal[1])+
geom_point(size=2.8,color=pal[1])+
geom_text(aes(x=high*1.12,label=txt),hjust=0,size=3)+
scale_x_log10(expand=expansion(mult=c(.05,.30)))+
labs(title="Care arrangement and oral-health outcomes",
subtitle="Residential vs foster care; adjusted for age and gender",
x="Adjusted PR / IRR (95% CI)",y=NULL)+theme_pub
savep(p_care,"care_adjusted_forest_pvalues",9,5)
# 2. Behavioural-analysis forest plot
beh_plot <- beh_adjusted |> filter(outcome=="any_untreated",status!="Not estimated",
!is.na(PR),low>0,high>0) |>
mutate(txt=sprintf("p = %.3f",p),
label=paste0(exposure,"\n",exposed," vs ",reference))
p_beh <- ggplot(beh_plot,aes(PR,fct_rev(label)))+
geom_vline(xintercept=1,linetype=2,color="grey60")+
geom_errorbar(aes(xmin=low,xmax=high),orientation="y",width=.12,color=pal[1])+
geom_point(size=2.8,color=pal[1])+
geom_text(aes(x=high*1.12,label=txt),hjust=0,size=3)+
scale_x_log10(expand=expansion(mult=c(.05,.35)))+
labs(title="Behavioural factors and untreated caries",
subtitle="Adjusted for age and gender",
x="Adjusted prevalence ratio (95% CI)",y=NULL)+theme_pub
savep(p_beh,"behaviour_adjusted_forest_pvalues",9,4)
