library(readxl);
d <- read_excel("biomedical_data.xlsx", sheet="Biomedical_Data")
head(d)
d$treatment_arm <- relevel(factor(d$treatment_arm),"Control");
d$baseline_severity <- factor(d$baseline_severity,c("Mild","Moderate","Severe"));
d$sbp_change <- d$sbp_week12_mmHg-d$sbp_baseline_mmHg;
d$biomarker_change <- d$biomarker_week12_ng_mL-d$biomarker_baseline_ng_mL
m6a <- lm(sbp_week12_mmHg ~ sbp_baseline_mmHg, data=d); round(coef(summary(m6a)),3)
plot(sbp_week12_mmHg ~ sbp_baseline_mmHg, data=d); abline(m6a)
m6b <- lm(sbp_week12_mmHg ~ sbp_baseline_mmHg+treatment_arm+age_years+bmi_kg_m2+adherence_pct, data=d);
round(coef(summary(m6b)),3);
round(c(R2=summary(m6b)$r.squared,Adj_R2=summary(m6b)$adj.r.squared),3)
m6c <- lm(biomarker_change ~ treatment_arm*adherence_pct+biomarker_baseline_ng_mL+age_years, data=d); round(coef(summary(m6c)),3)
par(mfrow=c(1,3)); plot(m6b,which=c(1,2,4)); par(mfrow=c(1,1))
g7a <- glm(clinical_response_12w ~ treatment_arm+age_years+baseline_severity+adherence_pct, family=binomial, data=d); round(coef(summary(g7a)),3)
g7a0 <- glm(clinical_response_12w ~ age_years+baseline_severity+adherence_pct, family=binomial, data=d); anova(g7a0,g7a,test="Chisq")
d$p_response <- predict(g7a,type="response"); head(d[c("clinical_response_12w","p_response")])
