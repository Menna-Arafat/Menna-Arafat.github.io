miss <- cohort |> dplyr::select(age,gender,care_group,perm_dmft,perm_d,perm_m,perm_f,primary_dmft,primary_d,primary_m,primary_f,plaque_score,bpe_max,bewe,ortho_assessment,brush_group,fluoride_group,snack_raw,drink_raw,visits,failed_appointments) |>
summarise(across(everything(),~mean(is.na(.))*100)) |> pivot_longer(everything(),names_to="variable",values_to="missing_pct") |> arrange(desc(missing_pct))
write_out(miss,"missingness")
# Cohort profile
# cohort_numeric <- bind_rows(nsum(cohort$age)|>mutate(variable="Age (years)",.before=1), nsum(cohort$visits)|>
#                               mutate(variable="Visits provided",.before=1))
# write_out(cohort_numeric,"cohort_numeric");
cohort_cat <- bind_rows(cat_sum(cohort,"age_group","Age group"),cat_sum(cohort,"gender","Gender"),
cat_sum(cohort,"care_group","Looked-after arrangement"),cat_sum(cohort,"caries_risk","Caries risk status"))
write_out(cohort_cat,"cohort_categorical")
#-------------------------------------------------------------------------------
#the percentage of participants with ≥1 failed appointment among those with failed-appointment data recorded
attendance_age <- cohort |> filter(!is.na(age_group),!is.na(failed_appointments)) |> group_by(age_group) |>
summarise(n=n(),failed_any_n=sum(failed_appointments>0),failed_any_pct=100*mean(failed_appointments>0),median_visits=median(visits,na.rm=TRUE),median_failed=median(failed_appointments,na.rm=TRUE),.groups="drop")
# Caries: prevalence, severity, unmet need
caries_prev <- bind_rows(prev(perm$caries_experience,"Permanent caries experience: D3-6 MFT >0 (age 6-18)"),
prev(perm$untreated_caries,"Permanent untreated cavitated caries: D>0 (age 6-18)"),
prev(primary$caries_experience,"Primary caries experience: d3-6 mft >0 (age 3-11)"),
prev(primary$untreated_caries,"Primary untreated cavitated caries: d>0 (age 3-11)"),
prev(cohort$any_caries,"Any age-appropriate caries experience"),
prev(cohort$any_untreated,"Any age-appropriate untreated cavitated caries"))
write_out(caries_prev,"caries_prevalence")
caries_long <- cohort |> dplyr::select(id,age,age_group,perm_dmft,primary_dmft) |> pivot_longer(c(perm_dmft,primary_dmft),names_to="index",values_to="score") |> mutate(index=recode(index,perm_dmft="Permanent D3-6 MFT",primary_dmft="Primary d3-6 mft")) |> filter((index=="Permanent D3-6 MFT"&age>=6)|(index=="Primary d3-6 mft"&age<12))
caries_severity <- caries_long |> group_by(index,age_group) |> summarise(n=sum(!is.na(score)),mean=mean(score,na.rm=TRUE),sd=sd(score,na.rm=TRUE),median=median(score,na.rm=TRUE),q1=quantile(score,.25,na.rm=TRUE),q3=quantile(score,.75,na.rm=TRUE),.groups="drop")
write_out(caries_severity,"caries_severity_by_age")
perm_u <- perm |> filter(perm_dmft_consistent %in% TRUE,perm_dmft>0); primary_u <- primary |> filter(primary_dmft_consistent %in% TRUE,primary_dmft>0)
unmet <- bind_rows(tibble(dentition="Permanent (age 6-18)",n=nrow(perm_u),aggregate_D_over_DMFT_pct=100*sum(perm_u$perm_d)/sum(perm_u$perm_dmft),individual_median_pct=100*median(perm_u$perm_unmet_ratio),q1_pct=100*quantile(perm_u$perm_unmet_ratio,.25),q3_pct=100*quantile(perm_u$perm_unmet_ratio,.75)),tibble(dentition="Primary (age 3-11)",n=nrow(primary_u),aggregate_D_over_DMFT_pct=100*sum(primary_u$primary_d)/sum(primary_u$primary_dmft),individual_median_pct=100*median(primary_u$primary_unmet_ratio),q1_pct=100*quantile(primary_u$primary_unmet_ratio,.25),q3_pct=100*quantile(primary_u$primary_unmet_ratio,.75)))
write_out(unmet,"unmet_treatment_need")
components <- bind_rows(perm |> filter(perm_dmft_consistent %in% TRUE) |> summarise(D=sum(perm_d),M=sum(perm_m),F=sum(perm_f)) |> mutate(dentition="Permanent",.before=1),primary |> filter(primary_dmft_consistent %in% TRUE) |> summarise(D=sum(primary_d),M=sum(primary_m),F=sum(primary_f)) |> mutate(dentition="Primary",.before=1)) |> pivot_longer(c(D,M,F),names_to="component",values_to="teeth") |> group_by(dentition) |> mutate(share=teeth/sum(teeth)) |> ungroup()
write_out(components,"dmft_component_shares")
#-------------------------------------------------------------------------------
# Periodontal, plaque, soft tissue
bpe_dist <- bpe |> count(bpe_age,bpe_max,name="n") |> group_by(bpe_age) |> mutate(pct=100*n/sum(n)) |> ungroup()
bpe_prev <- bind_rows(prev(bpe$bpe_max>=1,"BPE >=1, age 7-18"),prev(bpe$bpe_max>=2,"BPE >=2, age 7-18"),prev(bpe |> filter(age>=12) |> pull(bpe_max) >=3,"BPE >=3, age 12-18"))
plaque_summary <- bind_rows(nsum(cohort$plaque_score)|>mutate(age_group="Overall",.before=1),cohort |> filter(!is.na(age_group)) |> group_by(age_group) |> group_modify(~nsum(.x$plaque_score)) |> ungroup())
soft_prev <- bind_rows(prev(cohort$soft_tissue_any,"Any recorded soft-tissue/acute finding"),prev(cohort$swelling=="Yes","Swelling"),prev(cohort$sinus=="Yes","Sinus"),prev(cohort$abscess=="Yes","Abscess"))
write_out(bpe_dist,"bpe_distribution"); write_out(bpe_prev,"bpe_prevalence"); write_out(plaque_summary,"plaque_summary"); write_out(soft_prev,"soft_tissue")
#-------------------------------------------------------------------------------
# BEWE + orthodontics
bewe_summary <- bind_rows(nsum(cohort$bewe)|>mutate(metric="BEWE cumulative score",.before=1))
bewe_risk <- cohort |> filter(!is.na(bewe_risk)) |> count(age_group,bewe_risk,name="n") |> group_by(age_group) |> mutate(pct=100*n/sum(n)) |> ungroup()
bewe_prev <- bind_rows(prev(cohort$bewe>0,"Any erosive tooth wear: BEWE >0"),prev(cohort$bewe>=3,"BEWE low/medium/high risk: score >=3"))
ortho <- bind_rows(prev(cohort$ortho_assessment=="Yes","Orthodontic assessment carried out (among recorded)"),prev(cohort$ortho_entry_referral,"Incoming referral reason included orthodontics"))
write_out(bewe_summary,"bewe_summary"); write_out(bewe_risk,"bewe_risk_by_age"); write_out(bewe_prev,"bewe_prevalence"); write_out(ortho,"orthodontic_available_measures")
# Behaviours + diet
behaviour <- bind_rows(cat_sum(cohort,"brush_group","Brushing frequency"),cat_sum(cohort,"fluoride_group","Fluoride toothpaste"),cat_sum(cohort,"brushing_assistance","Brushing assistance"),cat_sum(cohort,"drink_group","Drink group"),cat_sum(cohort,"snack_group","Snack group"))
write_out(behaviour,"behaviours")
diet_top <- bind_rows(cohort |> filter(!is.na(snack_raw)) |> mutate(item=str_to_sentence(str_to_lower(snack_raw))) |> count(item,sort=TRUE,name="n") |> slice_head(n=15) |> mutate(type="Snack",.before=1),cohort |> filter(!is.na(drink_raw)) |> mutate(item=str_to_sentence(str_to_lower(drink_raw))) |> count(item,sort=TRUE,name="n") |> slice_head(n=15) |> mutate(type="Drink",.before=1))
write_out(diet_top,"top_snacks_drinks")
write_out(cohort |> filter(snack_group=="Other/unclear"|drink_group=="Other/unclear") |> dplyr::select(id,snack_raw,snack_group,drink_raw,drink_group),"diet_values_to_review")
assoc <- bind_rows(gprev(cohort,"brush_group","any_caries","Brushing frequency"),
gprev(cohort,"fluoride_group","any_caries","Fluoride toothpaste"),
gprev(cohort,"drink_group","any_caries","Drink group"),gprev(cohort,"snack_group","any_caries","Snack group"),
gprev(cohort,"brush_group","any_untreated","Brushing frequency"),
gprev(cohort,"fluoride_group","any_untreated","Fluoride toothpaste"),
gprev(cohort,"drink_group","any_untreated","Drink group"),gprev(cohort,"snack_group","any_untreated","Snack group"))
write_out(assoc,"caries_by_behaviours")
# Service model
service_need <- bind_rows(prev(cohort$radiographs_required=="Yes","Radiographs required"),prev(cohort$consultations_required=="Yes","Consultations required"),prev(cohort$restorations_required=="Yes","Restorations required"),prev(cohort$extractions_required=="Yes","Extractions required"))
visits_summary <- bind_rows(nsum(cohort$visits)|>mutate(metric="Visits provided",.before=1),nsum(cohort$failed_appointments)|>mutate(metric="Failed appointments (recorded only)",.before=1),prev(cohort$failed_appointments>0,"At least one failed appointment (recorded only)"))
write_out(service_need,"service_treatment_needs"); write_out(visits_summary,"service_visits_failed_appointments")
tbl1=cohort |> count(care_group,name="n") |> left_join(cohort |> group_by(care_group) |>
summarise(median_visits=median(visits,na.rm=TRUE),
iqr_visits=IQR(visits,na.rm=TRUE),
failed_appt_recorded=sum(!is.na(failed_appointments)),
failed_appt_any=pct_true(failed_appointments>0),.groups="drop"),by="care_group")
write_out(tbl1, "service_by_care_arrangement")
#-------------------------------------------------------------------------------
# Plots
p1 <- caries_prev |> ggplot(aes(x=pct,y=fct_rev(indicator)))+geom_segment(aes(x=low,xend=high,yend=fct_rev(indicator)),linewidth=.8,color=pal[1])+
geom_point(size=3,color=pal[1])+scale_x_continuous(labels=\(x)paste0(x,"%"),limits=c(0,100))+
labs(title="Caries burden",subtitle="Exact 95% binomial confidence intervals; age-group",x="Prevalence",y=NULL)
savep(p1,"caries_prevalence",9,5.5)
p2 <- caries_long |> filter(!is.na(score),!is.na(age_group)) |>
ggplot(aes(age_group,score,fill=index))+
geom_violin(trim=FALSE,alpha=.35,color=NA)+geom_boxplot(width=.18,outlier.shape=NA,alpha=.8)+
facet_wrap(~index,scales="free")+
scale_fill_manual(values=pal[1:2],guide="none")+
labs(title="Distribution of Caries experience by age group and dentition",subtitle="D3-6 threshold; box = median/IQR, violin = distribution",x="Age group",y="DMFT / dmft score")
savep(p2,"caries_severity_by_age",9,5)
p3 <- components |> ggplot(aes(dentition,share,fill=component))+
geom_col(width=.62)+geom_text(aes(label=scales::percent(share,accuracy=1)),position=position_stack(vjust=.5),color="white",
fontface="bold",size=4)+coord_flip()+scale_y_continuous(labels=scales::percent)+
scale_fill_manual(values=pal[c(5,3,1)],labels=c("D (Decayed)","M (Missing due to caries)","F (Filled)"))+
labs(title="DMFT/dmft component composition",subtitle="The recorded index indicates D (Decayed) , M (Missing) , F (Filled)",
x=NULL,y="Share of caries-experience components",fill="Component")
savep(p3,"dmft_components_unmet_need",8,4.5)
p4 <- cohort |> filter(!is.na(plaque_score),!is.na(age_group)) |> ggplot(aes(age_group,plaque_score,fill=age_group))+geom_violin(trim=FALSE,alpha=.35,color=NA)+geom_boxplot(width=.16,outlier.alpha=.25)+scale_fill_manual(values=pal[1:4],guide="none")+labs(title="Silness-Loe plaque score by age group",x="Age group",y="Patient plaque score")
savep(p4,"plaque_by_age",7.5,5)
p5 <- bpe_dist |> group_by(bpe_age) |> mutate(total=sum(n),age_label=paste0(bpe_age," (n=",total,")"),bpe_label=factor(case_when(bpe_max==0~"0 (Healthy)",bpe_max==1~"1 (Bleeding)",bpe_max==2~"2 (Calculus)",bpe_max==3~"3 (Pocket 4-5 mm)",bpe_max==4~"4 (Pocket ≥6 mm)"),
levels=c("0 (Healthy)","1 (Bleeding)","2 (Calculus)","3 (Pocket 4-5 mm)","4 (Pocket ≥6 mm)"))) |>
ggplot(aes(age_label,pct,fill=bpe_label))+geom_col(width=.65)+geom_text(aes(label=if_else(pct>=5,paste0(round(pct),"%\n(n=",n,")"),"")),position=position_stack(vjust=.5),size=3)+
scale_y_continuous(labels=\(x)paste0(x,"%"),limits=c(0,100))+scale_fill_manual(values=pal[3:7],drop=FALSE)+
labs(title="Maximum Basic Periodontal Examination (BPE) code by age group",
subtitle="Maximum recorded BPE code per participant; ages 7-11",x="Age group",y="Participants (%)",fill="Maximum BPE code")
savep(p5,"bpe_distribution",8.5,5.5)
p6 <- bewe_risk |> ggplot(aes(age_group,pct,fill=bewe_risk))+geom_col(width=.65)+scale_y_continuous(labels=\(x)paste0(x,"%"))+scale_fill_manual(values=pal[c(3,2,5,4)])+labs(title="Erosive tooth wear risk by age",subtitle="Original/legacy BEWE cumulative risk categories",x="Age group",y="Participants",fill="BEWE risk")
savep(p6,"bewe_risk",8,5)
p7 <- behaviour |> filter(variable %in% c("Brushing frequency","Fluoride toothpaste")) |> ggplot(aes(pct,fct_reorder(level,pct),fill=variable))+geom_col(width=.65)+facet_wrap(~variable,scales="free_y")+scale_x_continuous(labels=\(x)paste0(x,"%"))+scale_fill_manual(values=pal[1:2],guide="none")+labs(title="Oral-hygiene behaviours",subtitle="Percentages among participants with a recorded response",x="Percent",y=NULL)
savep(p7,"oral_hygiene_behaviours",9,5)
p8 <- diet_top |> group_by(type) |> mutate(item=fct_reorder(item,n)) |> ungroup() |> ggplot(aes(n,item,fill=type))+geom_col(width=.65)+facet_wrap(~type,scales="free_y")+scale_fill_manual(values=pal[2:3],guide="none")+labs(title="Most frequently reported snacks and drinks",subtitle="Top 15 cleaned free-text responses",x="Participants",y=NULL)
savep(p8,"top_snacks_drinks",10,7)
p9 <- service_need |> ggplot(aes(pct,fct_rev(indicator)))+geom_col(width=.62,fill=pal[1])+geom_text(aes(label=sprintf("%.1f%%",pct)),hjust=-.1)+scale_x_continuous(limits=c(0,max(service_need$pct,na.rm=TRUE)*1.15),expand=expansion(mult=c(0,.02)))+labs(title="Recorded treatment/service needs",subtitle="Percentages use non-missing responses for each item",x="Percent requiring service",y=NULL)
savep(p9,"service_needs",8.5,4.8)
p10 <- cohort |> filter(!is.na(visits)) |> ggplot(aes(visits))+geom_histogram(binwidth=1,boundary=.5,closed="left",fill=pal[1],color="white")+scale_x_continuous(breaks=scales::breaks_pretty())+labs(title="Number of visits provided by TC Malta",x="Visits",y="Participants")
savep(p10,"visits_distribution",7.5,4.8)
p11 <- miss |> slice_max(missing_pct,n=15) |> ggplot(aes(missing_pct,fct_reorder(variable,missing_pct)))+geom_col(width=.65,fill=pal[7])+scale_x_continuous(labels=\(x)paste0(x,"%"),limits=c(0,100))+labs(title="Missingness in key analysis variables",x="Missing",y=NULL)
savep(p11,"missingness",8.5,6)
assoc_plot <- assoc |> filter(outcome=="any_untreated",n>=10) |> group_by(exposure) |> filter(n_distinct(level)>=2) |> ungroup()
p12 <- assoc_plot |> ggplot(aes(pct,fct_reorder(level,pct)))+
geom_segment(aes(x=low,xend=high,yend=fct_reorder(level,pct)),color=pal[1],linewidth=.7)+
geom_point(color=pal[1],size=2.6)+facet_wrap(~exposure,scales="free_y")+
scale_x_continuous(labels=\(x)paste0(x,"%"),limits=c(0,100))+
labs(title="Untreated caries prevalence by reported behaviour",
subtitle="Crude descriptive prevalence with exact 95% CIs; levels with n <10 omitted",
x="Participants with untreated caries (%)",y=NULL)+
theme(plot.title=element_text(face="bold"),strip.text=element_text(face="bold"))
savep(p12,"untreated_caries_by_behaviours",10,7)
assoc_plot2 <- assoc |> filter(outcome=="any_caries",n>=10) |> group_by(exposure) |> filter(n_distinct(level)>=2) |> ungroup()
p13 <- assoc_plot2 |> ggplot(aes(pct,fct_reorder(level,pct)))+
geom_segment(aes(x=low,xend=high,yend=fct_reorder(level,pct)),color=pal[1],linewidth=.7)+
geom_point(color=pal[1],size=2.6)+facet_wrap(~exposure,scales="free_y")+
scale_x_continuous(labels=\(x)paste0(x,"%"),limits=c(0,100))+
labs(title="Caries prevalence by reported behaviour",
subtitle="Crude descriptive prevalence with exact 95% CIs; levels with n <10 omitted",
x="Participants with any caries (%)",y=NULL)+
theme(plot.title=element_text(face="bold"),strip.text=element_text(face="bold"))
savep(p13,"any_caries_by_behaviours",10,7)
#-------------------------------------------------------------------------------
plot_cat <- function(v) cohort_cat |> filter(variable==v) |> ggplot(aes(level,pct)) +
geom_col(fill="#0a3d3f",width=.6) +
geom_text(aes(label=sprintf("%.1f%% (n=%d)",pct,n)),vjust=-.3,size=3) +
labs(title=paste("Distribution of", v),x=NULL,y=NULL) + theme_minimal()
p_age <- plot_cat("Age group"); p_sex <- plot_cat("Gender")
p_care <- plot_cat("Looked-after arrangement"); p_risk <- plot_cat("Caries risk status")
savep(p_age,  "Dist_age_group",        5, 4)
savep(p_sex,  "Dist_gender",           5, 4)
savep(p_care, "Dist_care_arrangement", 5, 4)
savep(p_risk, "Dist_caries_risk",      5, 4)
#-------------------------------------------------------------------------------
message("Done. Plots: ",normalizePath(plot_dir,mustWork=FALSE)," | Outputs: ",normalizePath(outdir,mustWork=FALSE))
