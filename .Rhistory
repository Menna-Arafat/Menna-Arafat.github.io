# writeLines(c(
#   "Publication analysis notes",
#   "Cohort: eligible participants aged 3 to <22 years.",
#   "Primary descriptive estimates use available-case denominators and exact binomial 95% CIs.",
#   "Permanent-dentition models include age >=6; primary-dentition models include age <12.",
#   "Care-arrangement models compare residential with foster care and adjust for nonlinear age (3-df natural spline) and sex.",
#   "Count outcomes use negative-binomial regression when estimable, with robust HC3 CIs; binary outcomes use modified Poisson regression with robust HC3 CIs; plaque uses OLS with HC3 CIs.",
#   "BPE is descriptive only because allowable codes differ at ages 7-11 versus older participants; invalid codes >2 at ages 7-11 are excluded and exported for QC.",
#   "Behaviour analyses use untreated caries as the preferred contemporaneous outcome; caries experience is secondary because it is cumulative.",
#   "Age-stratified behavioural PRs are not estimated when either exposure group has n <10 or when outcome information is too sparse.",
#   "Behavioural analyses are cross-sectional and exploratory; estimates should not be interpreted causally.",
#   "BH-FDR adjusted p-values are exported for the prespecified adjusted care models and separately within each behavioural outcome."
# ),file.path(outdir,"analysis_notes.txt"))
# Looked-after children oral-health service evaluation
# Primary analysis: ages 3 through 18 years => 3 <= age < 19.
# BPE: sBPE screening starts at age 7; ages 7-11 use codes 0-2; older adolescents use full codes.
# BEWE: legacy cumulative categories 0-2 none, 3-8 low, 9-13 medium, >=14 high.
suppressPackageStartupMessages({library(tidyverse); library(readxl); library(data.table)})
proj_dir= "/Users/mennaarafat/Documents/Projects/Dental/"
plot_dir <- file.path(proj_dir, "plots"); outdir <- file.path(proj_dir, "outputs")
dir.create(plot_dir, recursive=TRUE, showWarnings=FALSE); dir.create(outdir, recursive=TRUE, showWarnings=FALSE)
# Data
data_file <- file.path(proj_dir, "input/Data Collection and Extraction 315_315.xlsx")
#-------------------------------------------------------------------------------
# Helpers
txt <- function(x){z <- str_squish(as.character(x)); z[z %in% c("","NA","N/A","n/a")] <- NA_character_; z}
num <- function(x) suppressWarnings(as.numeric(as.character(x)))
date_xl <- function(x) if(inherits(x,"Date")) x else if(inherits(x,"POSIXt")) as.Date(x) else as.Date(suppressWarnings(as.numeric(x)), origin="1899-12-30")
yn <- function(x){z <- str_to_lower(txt(x)); case_when(z %in% c("yes","y")~"Yes", z %in% c("no","n")~"No", TRUE~NA_character_)}
need_yn <- function(x){z <- str_to_lower(txt(x)); n <- num(x); case_when(!is.na(n)&n>0~"Yes", !is.na(n)&n==0~"No", z=="yes"~"Yes", z %in% c("no","np")~"No", TRUE~NA_character_)}
row_max <- function(...) {z <- cbind(...); apply(z,1,function(r) if(all(is.na(r))) NA_real_ else max(r,na.rm=TRUE))}
any_yes <- function(...) {z <- cbind(...); apply(z,1,function(r) if(all(is.na(r))) NA else any(r=="Yes",na.rm=TRUE))}
pct_true <- function(x) if(all(is.na(x))) NA_real_ else 100*mean(x,na.rm=TRUE)
nsum <- function(x){x <- x[!is.na(x)]; tibble(n=length(x),
mean=if(length(x))mean(x) else NA_real_,sd=if(length(x)>1)sd(x) else NA_real_,median=if(length(x))median(x) else NA_real_,
q1=if(length(x))unname(quantile(x,.25)) else NA_real_,
q3=if(length(x))unname(quantile(x,.75)) else NA_real_,
min=if(length(x))min(x) else NA_real_,max=if(length(x))max(x) else NA_real_)}
prev <- function(x,label){
x <- x[!is.na(x)]; n <- length(x);
k <- sum(x); ci <- if(n) binom.test(k,n)$conf.int*100 else c(NA,NA);
tibble(indicator=label,n=n,events=k,pct=if(n)100*k/n else NA_real_,low=ci[1],high=ci[2])}
cat_sum <- function(d,var,label){d |> transmute(level=.data[[var]]) |> filter(!is.na(level)) |>
count(level,name="n") |> mutate(variable=label,pct=100*n/sum(n),.before=1)}
gprev <- function(d,group,outcome,exposure){
d |> filter(!is.na(.data[[group]]),!is.na(.data[[outcome]])) |>
group_by(level=.data[[group]]) |> summarise(n=n(),events=sum(.data[[outcome]]),.groups="drop") |> rowwise() |>
mutate(group=.env$group,exposure=.env$exposure,outcome=.env$outcome,
pct=100*events/n,low=100*binom.test(events,n)$conf.int[1],high=100*binom.test(events,n)$conf.int[2],
.before=1) |> ungroup()
}
write_out <- function(x,name) fwrite(x,file.path(outdir,paste0(name,".csv")),row.names=F)
savep <- function(p,name,w=8,h=5){ggsave(file.path(plot_dir,paste0(name,".png")),p,width=w,height=h,dpi=320,bg="white")
} # ggsave(file.path(plot_dir,paste0(name,".pdf")),p,width=w,height=h,bg="white")
pal <- c("#56106E","#89226A","#BB3754" ,"tan" ,"antiquewhite2","#999999", "#F98C0A","#0a3d3f", "#798E87")
theme_set(theme_minimal(base_size=12)+theme(panel.grid.minor=element_blank(),plot.title=element_text(face="bold",size=14),plot.subtitle=element_text(color="grey35"),axis.title=element_text(face="bold"),legend.position="bottom"))
#-------------------------------------------------------------------------------
# Import
raw <- read_excel(data_file,sheet="Sheet1",skip=1,.name_repair="minimal")
headers <- names(raw); stopifnot(ncol(raw)>=116, str_trim(headers[1])=="Participant Number",
str_trim(headers[6])=="Age", str_detect(headers[52],"D3-6 MFT"),
str_detect(headers[91],"PIaque Score"))
raw_col <- function(name, occurrence=1L){
idx <- which(str_trim(headers) == str_trim(name))
if(length(idx) < occurrence) stop("Header not found (or occurrence missing): ", name)
raw[[idx[[occurrence]]]]
}
#-------------------------------------------------------------------------------
# Analysis variables/ headers
d <- tibble(
id=num(raw_col("Participant Number")), exam_date=date_xl(raw_col("Date of First Examination:")), dob=date_xl(raw_col("DOB:")),
age=num(raw_col("Age")), gender_raw=txt(raw_col("Gender")),
care_raw=txt(raw_col("Type of Looked After Arrangement")),
reason_care=txt(raw_col("Reason why in the care System")), referred_by=txt(raw_col("Referred By:")), referred_for=txt(raw_col("Referred For:")), presenting_complaint=txt(raw_col("History of Presenting Complaint:")),
snack_raw=txt(raw_col("Most Frequent Snack")), drink_raw=txt(raw_col("Most Frequent Drink")),
brushes=yn(raw_col("Brushes Yes/No")), brushing_assistance=yn(raw_col("Brushes with assistance Yes/No")), toothpaste_raw=txt(raw_col("Type of Toothpaste used")), brushing_frequency_raw=txt(raw_col("Brushing Frequency")), brushing_time=txt(raw_col("Time of Brushing")),
soft_tissue_abnormal=yn(raw_col("Any Abnoraml Finding on Soft Tissues")),
swelling=yn(raw_col("Swelling")), sinus=yn(raw_col("Sinus Present")),
abscess=yn(raw_col("Abscess present")),
bewe=num(raw_col("Erosive Wear Cumulative Score")),
perm_d1_6_mft=num(raw_col("D1-6 MFT")),
perm_dmft=num(raw_col("D3-6 MFT")),
reversible_lesions=num(raw_col("Number of Reversible lesions")),
perm_d1_6=num(raw_col("Total Number of carious untreated teeth - reversible and irreversible - (ICDAS 1 - 6) D",1)),
perm_d=num(raw_col("Total Number of carious untreated teeth -  cavitated/irreversible - (ICDAS 3 - 6) D")),
perm_m=num(raw_col("Number of teeth extracted (missing) due to caries (97) M",1)),
perm_f=num(raw_col("Total number of filled Teeth F",1)),
primary_dmft=num(raw_col("d3-6 mft")),
primary_d1_2_mft=num(raw_col("d1-2 mft")),
primary_d1_6=num(raw_col("Total Number of carious untreated teeth - reversible and irreversible - (ICDAS 1 - 6) D",2)),
primary_d=num(raw_col("Total Number of carious untreated teeth -  irreversible - (ICDAS code 3 - 6) D")),
primary_m=num(raw_col("Number of teeth extracted (missing) due to caries (97) M",2)),
primary_f=num(raw_col("Total number of filled Teeth F",2)),
ecc=yn(raw_col("ECC")), mih=txt(raw_col("MIH")), hspm=txt(raw_col("HSPM")),
plaque_16_55=num(raw_col("Plaque Index 16/55 average")), plaque_52=num(raw_col("Plaque Index 12/52 average")),
plaque_26_64=num(raw_col("Plaque Index 26/64 average")), plaque_36_75=num(raw_col("Plaque Index 36/75 average")), plaque_32_72=num(raw_col("Plaque Index 32/72 average")), plaque_44_84=num(raw_col("Plaque Index 44/84 average")),
plaque_score=num(raw_col("Patient PIaque Score")),
bpe_16_b=num(raw_col("BPE  16 buccal")), bpe_16_p=num(raw_col("BPE 16 Palatal")),
bpe_b=num(raw_col("BPE  11 buccal")), bpe_p=num(raw_col("BPE 11 Palatal")),
bpe_26_b=num(raw_col("BPE  26 buccal")), bpe_26_p=num(raw_col("BPE 26 Palatal")), bpe_36_b=num(raw_col("BPE  36 buccal")), bpe_36_p=num(raw_col("BPE 36 Palatal")), bpe_31_b=num(raw_col("BPE  31 buccal")), bpe_31_p=num(raw_col("BPE 31 Palatal")), bpe_46_b=num(raw_col("BPE  46 buccal")), bpe_46_p=num(raw_col("BPE 46 Palatal")),
hypoplasia=yn(raw_col("Hypoplasia")),
discolouration=yn(raw_col("Discolouration")), infraoccluded=yn(raw_col("Infra-occluded teeth")),
trauma=yn(raw_col("Trauma")), trauma_type=txt(raw_col("Type of Trauma")),
caries_risk_raw=txt(raw_col("Caries risk Status")), ortho_assessment=yn(raw_col("Ortho Assessment carried out.")),
radiographs_required=need_yn(raw_col("Radiographs Required")), consultations_required=need_yn(raw_col("Consultations Required")),
restorations_required=need_yn(raw_col("Restorations Required")), extractions_required=need_yn(raw_col("Extractions required")), visits=num(raw_col("Number of visits provided by TC Malta")), failed_appointments=num(raw_col("Number of Failed Appointments"))
) |> filter(!is.na(id))
# Cleaning + derivations of variables
d <- d |> mutate(
age_group=cut(age,breaks=c(3,6,12,19,22),right=FALSE,labels=c("3-5","6-11","12-18","19-21")),
gender=case_when(str_to_upper(gender_raw)=="M"~"Male",str_to_upper(gender_raw)=="F"~"Female",TRUE~NA_character_),
care_group=case_when(is.na(care_raw)~NA_character_,str_detect(str_to_lower(care_raw),"residential.*fost|fost.*residential")~"Mixed/other",str_detect(str_to_lower(care_raw),"fost")~"Foster care",str_detect(str_to_lower(care_raw),"residential")~"Residential care",TRUE~"Other"),
brush_group=case_when(brushes=="No"~"Never",is.na(brushing_frequency_raw)~NA_character_,str_detect(str_to_lower(brushing_frequency_raw),"twice daily|twice a day|three times|3 times|2 times|2/day")~">=2/day",str_detect(str_to_lower(brushing_frequency_raw),"once daily|once a day|1/day")~"1/day",str_detect(str_to_lower(brushing_frequency_raw),"occasion|not every day|weekly|week|irregular")~"<1/day",str_detect(str_to_lower(brushing_frequency_raw),"never")~"Never",TRUE~"Unclear"),
fluoride_group=case_when(is.na(toothpaste_raw)~NA_character_,str_detect(str_to_lower(toothpaste_raw),"without|wihtout")~"No",str_detect(str_to_lower(toothpaste_raw),"fluor|f toothpaste")~"Yes",TRUE~"Unknown"),
snack_group=case_when(is.na(snack_raw)~NA_character_,str_detect(str_to_lower(snack_raw),
"sweet|choc|bisc|cake|cookie|candy|sugar|nutella|ice.?cream|dessert")~"Sweet/sugar rich",
str_detect(str_to_lower(snack_raw),"fruit")~"Fruit",str_detect(str_to_lower(snack_raw),
"crisp|twistee|chip|bread|cracker|sandwich|pizza|pastizz")~"Savoury/starchy",
str_detect(str_to_lower(snack_raw),"cheese|yog|protein|nut|egg")~"Dairy/protein",TRUE~"Other/unclear"),
drink_group=case_when(is.na(drink_raw)~NA_character_,str_detect(str_to_lower(drink_raw),"soft|coke|cola|energy|juice|squash|iced tea|ice tea|fanta|sprite|lemonade")~"Sugar-sweetened/acidic",
str_detect(str_to_lower(drink_raw),"water")~"Water",str_detect(str_to_lower(drink_raw),"milk")~"Milk",str_detect(str_to_lower(drink_raw),"tea|coffee")~"Tea/coffee",TRUE~"Other/unclear"),
caries_risk=case_when(str_detect(str_to_lower(caries_risk_raw),"low")~"Low",str_detect(str_to_lower(caries_risk_raw),"moderate|medium")~"Moderate",str_detect(str_to_lower(caries_risk_raw),"high")~"High",TRUE~NA_character_),
bewe_risk=factor(case_when(is.na(bewe)~NA_character_,bewe<=2~"None (0-2)",bewe<=8~"Low (3-8)",
bewe<=13~"Medium (9-13)",TRUE~"High (>=14)"),levels=c("None (0-2)","Low (3-8)","Medium (9-13)","High (>=14)"),ordered=TRUE),
bpe_max=row_max(bpe_16_b,bpe_16_p,bpe_b,bpe_p,bpe_26_b,bpe_26_p,bpe_36_b,bpe_36_p,bpe_31_b,bpe_31_p,bpe_46_b,bpe_46_p),
soft_tissue_any=any_yes(soft_tissue_abnormal,swelling,sinus,abscess),
perm_dmft_calc=if_else(complete.cases(perm_d,perm_m,perm_f), perm_d+perm_m+perm_f,NA_real_),
primary_dmft_calc=if_else(complete.cases(primary_d,primary_m,primary_f),primary_d+primary_m+primary_f,NA_real_),
perm_dmft_consistent=case_when(is.na(perm_dmft)|is.na(perm_dmft_calc)~NA,TRUE~abs(perm_dmft-perm_dmft_calc)<1e-8),
primary_dmft_consistent=case_when(is.na(primary_dmft)|is.na(primary_dmft_calc)~NA,TRUE~abs(primary_dmft-primary_dmft_calc)<1e-8),
perm_unmet_ratio=if_else(perm_dmft>0 & perm_dmft_consistent %in% TRUE,perm_d/perm_dmft,NA_real_),
primary_unmet_ratio=if_else(primary_dmft>0 & primary_dmft_consistent %in% TRUE,primary_d/primary_dmft,NA_real_),
ortho_entry_referral=case_when(is.na(referred_for)~NA,str_detect(str_to_lower(referred_for),"ortho")~TRUE,TRUE~FALSE),
any_caries=case_when(age<6 & !is.na(primary_dmft)~primary_dmft>0,
age>=6&age<12 &(!is.na(perm_dmft)|!is.na(primary_dmft))~coalesce(perm_dmft,0)+coalesce(primary_dmft,0)>0,
age>=12 &!is.na(perm_dmft)~perm_dmft>0,TRUE~NA),
any_untreated=case_when(age<6 & !is.na(primary_d)~primary_d>0,
age>=6&age<12 & (!is.na(perm_d)|!is.na(primary_d))~coalesce(perm_d,0)+coalesce(primary_d,0)>0,
age>=12 & !is.na(perm_d)~perm_d>0,TRUE~NA)
)
# For any_caries, any_untreated
# Age <6 → uses primary teeth only.
# Age 6–11 → uses both primary + permanent teeth.
# Age ≥12 → uses permanent teeth only.
# any_caries = TRUE if caries experience count > 0.
# any_untreated = TRUE if untreated caries count > 0.
range(d$age, na.rm=TRUE)
d <- d |> mutate(eligible = age >= 3 & age < 22)
dim(d)
cohort <- d |> filter(eligible)
dim(cohort)
#perm includes permanent dentition from age 6 onward, including adults; primary is restricted to children under 12; and BPE starts at age 7 and is stratified into 7–11, 12–18, and 19–21.
perm <- cohort |> filter(age>=6,!is.na(perm_dmft)) |> mutate(caries_experience=perm_dmft>0,untreated_caries=perm_d>0)
primary <- cohort |> filter(age<12,!is.na(primary_dmft)) |> mutate(caries_experience=primary_dmft>0,untreated_caries=primary_d>0)
bpe <- cohort |> filter(age>=7,!is.na(bpe_max)) |>
mutate(bpe_age=case_when(age<12~"7-11",age<19~"12-18",age<22~"19-21",TRUE~NA_character_))
#-------------------------------------------------------------------------------
# Data quality
id_list <- function(x) paste(unique(d$id[which(x %in% TRUE)]),collapse=", ")
qc <- tibble(metric=c("Rows with participant ID","Unique participant IDs","Duplicate IDs","Eligible age 3-21 [3,22)","Age <3","Age >=22","Missing age","Permanent DMFT component mismatches","Primary dmft component mismatches","BPE recorded age <7","BPE code >2 at age 7-11","Failed appointments missing"),
value=c(nrow(d),n_distinct(d$id),sum(duplicated(d$id)),sum(d$eligible,na.rm=TRUE),sum(d$age<3,na.rm=TRUE),sum(d$age>=22,na.rm=TRUE),sum(is.na(d$age)),sum(d$perm_dmft_consistent==FALSE,na.rm=TRUE),sum(d$primary_dmft_consistent==FALSE,na.rm=TRUE),sum(d$age<7&!is.na(d$bpe_max),na.rm=TRUE),sum(d$age>=7&d$age<12&d$bpe_max>2,na.rm=TRUE),sum(is.na(d$failed_appointments))),
exact_IDs=c(id_list(!is.na(d$id)),paste(unique(d$id),collapse=", "),id_list(duplicated(d$id)|duplicated(d$id,fromLast=TRUE)),id_list(d$eligible),id_list(d$age<3),id_list(d$age>=22),id_list(is.na(d$age)),id_list(d$perm_dmft_consistent==FALSE),id_list(d$primary_dmft_consistent==FALSE),id_list(d$age<7&!is.na(d$bpe_max)),id_list(d$age>=7&d$age<12&d$bpe_max>2),id_list(is.na(d$failed_appointments))))
write_out(qc,"qc_summary")
write_out(d,"cleaned_data")
data_gaps <- tribble(~objective,~status,~interpretation,
"Treatment completion rate","Not directly available","Required treatment and visit counts do not establish whether treatment was completed; calculate a completion rate would be problematic.",
"Patient/carer attendance pattern","Partially available","Only number of visits and failed appointments are present; carer attendance is not recorded and failed appointments are highly incomplete.",
"Malocclusion prevalence / orthodontic referral outcome","Not directly available","Ortho assessment completed and referral reason are available, but neither is a malocclusion diagnosis nor a documented referral outcome.",
"Reason for being in care","Very sparse","completeness should be improved.")
